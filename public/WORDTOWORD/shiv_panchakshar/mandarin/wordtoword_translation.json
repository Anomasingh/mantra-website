{
  "lines": [
    "戴着蛇王花环的",
    "三眼者",
    "身上涂满圣灰的",
    "向伟大的主",
    "永恒的",
    "纯洁的",
    "以虚空为衣的",
    "向他",
    "Na字",
    "化身",
    "顶礼",
    "向湿婆",
    "曼达基尼河的",
    "水与檀香",
    "涂抹的",
    "南迪之主",
    "与众神之主",
    "向伟大的主",
    "曼陀罗花",
    "与许多花",
    "受善敬的",
    "向他",
    "Ma字",
    "化身",
    "顶礼",
    "向湿婆",
    "向吉祥者",
    "对高丽莲花般的脸庞",
    "犹如太阳的",
    "破坏达克沙祭祀的",
    "青颈者",
    "公牛旗帜的",
    "向他",
    "Shi字",
    "化身",
    "顶礼",
    "向湿婆",
    "受极裕仙人投山仙人及乔达摩尊敬的",
    "其冠冕受伟大仙人和神灵敬拜的",
    "月亮与太阳",
    "及火为眼的",
    "向他",
    "Va字",
    "化身",
    "顶礼",
    "向湿婆",
    "化为夜叉形态的",
    "有着结缠发髻的",
    "手持比纳卡弓的",
    "永恒的",
    "神圣的",
    "神明",
    "以虚空为衣的",
    "向他",
    "Ya字",
    "化身",
    "顶礼",
    "向湿婆",
    "这个五字真言",
    "神圣的",
    "任何",
    "在湿婆面前诵读的人",
    "将到达湿婆界",
    "与湿婆",
    "一起",
    "同乐"
  ]
}