{
  "lines": [
    "谁",
    "洁白如茉莉月亮与冰霜",
    "谁",
    "穿着洁白的衣服",
    "谁",
    "手中装饰着极佳的维纳琴",
    "谁",
    "坐在白莲花上",
    "谁",
    "被梵天与毗湿奴",
    "以及湿婆等诸神",
    "永远",
    "敬拜",
    "她",
    "我",
    "愿保护",
    "萨拉斯瓦蒂女神",
    "神圣的母亲",
    "完全消除无知者",
    "肤色洁白者",
    "最高梵的",
    "精髓",
    "原始至高无上者",
    "遍及宇宙者",
    "手持维纳琴与书本并赐予无畏者",
    "消除无知黑暗者",
    "在手中",
    "水晶念珠",
    "持着",
    "在莲花座上",
    "安坐的",
    "我敬拜",
    "她",
    "至高无上的女神",
    "神圣的母亲",
    "赐予智慧者",
    "莎拉达女神"
  ]
