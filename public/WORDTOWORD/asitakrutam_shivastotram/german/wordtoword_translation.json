{
    "lines": [
        "Asita (der Weise)",
        "verfasst",
        "Shiva",
        "Hymne",
        "Asita",
        "sprach",
        "Höchster Lehrer der Welt",
        "Ehrerbietung an dich",
        "dem gütigen Shiva",
        "dem Spender von Glückseligkeit",
        "und",
        "dem Höchsten unter den Yogis",
        "und",
        "dem Meister-Yogi",
        "der Lehrer",
        "dem Guru",
        "Ehrerbietung",
        "Nektar der Unsterblichkeit für den Tod",
        "Zerstörer des Kreislaufs von Geburt und Tod",
        "Herr des Todes",
        "Samen des Todes",
        "Besieger des Todes",
        "Ehrerbietung",
        "dir",
        "Form der Zeit",
        "Zeit derer die Zeit berechnen",
        "Herr der Zeit",
        "Ursache von allem",
        "über die Zeit hinausgehend",
        "in der Zeit verweilend",
        "Zeit der Zeit",
        "Ehrerbietung",
        "dir",
        "über alle Eigenschaften hinaus",
        "Grundlage aller Eigenschaften",
        "Samen aller Eigenschaften",
        "Essenz aller Eigenschaften",
        "Herr der Begabten",
        "der Begabten",
        "der Samen (Ursache)",
        "der Begabten",
        "dem Guru",
        "Ehrerbietung",
        "dessen Natur Brahman ist",
        "Kenner des Brahman",
        "im Zustand von Brahman",
        "und",
        "vertieft",
        "Samen des Brahman",
        "in der Form",
        "Samen des Brahman",
        "Ehrerbietung",
        "dir",
        "so",
        "nach dem Lobpreisen",
        "Shiva",
        "nach der Verbeugung",
        "stand vor ihm",
        "der große Weise (Asita)",
        "mit tränengefüllten und mitleidigen Augen",
        "mit erschauerndem Körper",
        "von Asita",
        "verfasst",
        "diese Hymne",
        "mit Hingabe",
        "wer auch immer",
        "rezitiert",
        "für ein Jahr",
        "heilige Opfergaben verzehrend",
        "Shankaras",
        "der großen Seele",
        "er",
        "erlangt einen Gottgeweihten Vishnus",
        "als Sohn",
        "weise",
        "und langlebig",
        "der Arme",
        "wird wohlhabend",
        "der Stumme",
        "wird",
        "ein Gelehrter",
        "der Ehelose",
        "erlangt",
        "eine Frau",
        "tugendhaft",
        "und",
        "treu",
        "in dieser",
        "Welt",
        "Glück",
        "nach dem Genießen",
        "geht schließlich",
        "in die Gegenwart Shivas",
        "diese",
        "Hymne",
        "in alten Zeiten",
        "wurde gegeben",
        "von Brahma",
        "und",
        "an Prachetas",
        "Prachetas",
        "seinem Sohn Asita",
        "gab diese exzellente Hymne",
        "so",
        "im Shri Brahmavaivarta",
        "großen Purana",
        "im Kapitel über Krishnas Geburt",
        "von Asita verfasst",
        "die Shiva-Hymne",
        "ist vollendet"
    ]
}